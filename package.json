{
  "name": "bodypro-telemetry",
  "version": "3.0.0",
  "description": "BodyPro Advanced Personal Health, Fitness, and Biometric Telemetry Application (Web, iOS & Android)",
  "main": "index.html",
  "scripts": {
    "start": "npx serve . -l 3000",
    "cap:init": "npx cap init BodyPro com.bodypro.telemetry --web-dir .",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios"
  },
  "keywords": [
    "fitness",
    "nutrition",
    "telemetry",
    "pwa",
    "capacitor",
    "ios",
    "android"
  ],
  "author": "Joshua Michael Smolak",
  "license": "PROPRIETARY",
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}
